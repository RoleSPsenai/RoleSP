@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/global.css">
    <link rel="stylesheet" href="~/css/landingPage.css">
    <title>RolêSP</title>
</head>

<body>

    <header class="displayFlex">
        <img src="../../assets/Icon/Logos/Logo Colorido.svg" alt="Imagem da logo da empresa Rolê SP" class="logo-header">
        <nav>
            <ul class="nav displayFlex">
                <li><a href="" class="texto-nav">Sobre</a></li>
                <li><a href="" class="texto-nav">Contato</a></li>
            </ul>
        </nav>
        <a class="Button-Login" asp-controller="Login" asp-action="Index">Entrar</a>
    </header>
    <main>

        <div id="barraDecorativa"></div>

        <!--? Section1 -->

        <section class="section1 displayFlex">
            <div class="esquerda-section1">
                <div>
                    <h1 class="titulo-section1">São Paulo</h1>
                    <h2 class="subTitulo-slogan">é o destino... O resto é descoberta!</h2>
                </div>
                <p class="texto-slogan">Aqui você encontra não apenas os pontos turísticos famosos, mas também aqueles
                    cantinhos especiais que moradores e visitantes recomendam no dia a dia.</p>
            </div>
            <div class="direita-section1">
                <div class="fundo-mascote displayFlex">
                    <img src="~/assets/Icon/Mascoste/Husky-Section1-alt.png" alt="Husky" class="mascote">
                </div>
                <div class="container-cadastre-se displayFlex">
                    <div class="cadastre-se">
                        <p class="texto-cadastro">Ainda não tem uma conta?</p>
                        <div>
                            <Button class="Button-cadastre-se" id="btn-abrir-cadastro">Cadastre-se</Button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!--? Section2 -->

        <Section class="section2 displayFlex">
            <h1 class="titulo-section2">Filtros Principais</h1>
            <div class="container">
                <div class="carrossel">
                    <div class="item bgc1-carrossel-section1 displayFlex">
                        <div class="fundo-titulo-card">
                            <p class="titulo-card">Cafeterias</p>
                        </div>
                    </div>
                    <div class="item bgc2-carrossel-section1 displayFlex">
                        <div class="fundo-titulo-card">
                            <p class="titulo-card">Museus</p>
                        </div>
                    </div>
                    <div class="item bgc3-carrossel-section1 displayFlex">
                        <div class="fundo-titulo-card">
                            <p class="titulo-card">Restaurantes</p>
                        </div>
                    </div>
                    <div class="item bgc4-carrossel-section1 displayFlex">
                        <div class="fundo-titulo-card">
                            <p class="titulo-card">Natureza</p>
                        </div>
                    </div>
                    <div class="item bgc5-carrossel-section1 displayFlex">
                        <div class="fundo-titulo-card">
                            <p class="titulo-card">Livrarias</p>
                        </div>
                    </div>
                    <div class="item bgc6-carrossel-section1 displayFlex">
                        <div class="fundo-titulo-card">
                            <p class="titulo-card">Cultura</p>
                        </div>
                    </div>
                </div>
            </div>
        </Section>

        <!--? Section3 -->

        <section class="section3 displayFlex">
            <h1 class="titulo-section3 displayFlex">Melhores lugares</h1>

            <div class="main-section3">
                <div class="avaliacao-section3 displayFlex" id="casaAntonia-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">A Casa de Antonia</h3>
                            <p class="texto-dialogo-section3">Um refúgio acolhedor com clima de casa de vó. Bolos
                                caseiros, café quentinho e um
                                atendimento
                                que faz você querer voltar sempre. Simples, charmosa e cheia de sabor!</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="casaAntonia-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/a casa de antonia.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="cafezal-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">Cafezal do Instituto Biológico</h3>
                            <p class="texto-dialogo-section3">Um oásis verde em meio à cidade. O café é cultivado ali
                                mesmo, e o ambiente mistura
                                natureza,
                                história e aroma fresco. Ideal para uma pausa tranquila ou um passeio cultural.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="cafezal-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/cafezal.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="cinemateca-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">Cinemateca Brasileira</h3>
                            <p class="texto-dialogo-section3">Mais que um cinema, é um patrimônio da cultura nacional.
                                Sessões especiais, mostras raras
                                e
                                um clima nostálgico que encanta quem ama a sétima arte.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="cinemateca-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/cinemateca.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="hiTea-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">HiTea</h3>
                            <p class="texto-dialogo-section3">Combina o melhor da boa música com hambúrgueres artesanais
                                incríveis. Clima descontraído,
                                som
                                ao vivo e pratos que harmonizam perfeitamente com o ritmo do jazz.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="hiTea-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/HiTea.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="jazz-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">Jazz Restô e Burgers</h3>
                            <p class="texto-dialogo-section3">Combina o melhor da boa música com hambúrgueres artesanais
                                incríveis. Clima descontraído,
                                som
                                ao vivo e pratos que harmonizam perfeitamente com o ritmo do jazz.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="jazz-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/Jazz retro.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex ativo" id="kiki-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">Kiki Café</h3>
                            <p class="texto-dialogo-section3">No coração da cidade, o Kiki Café nasceu para ser muito
                                mais do que uma simples
                                cafeteria: é
                                um ponto de encontro para quem ama bons momentos, conversas leves e o aconchego de um
                                café
                                feito com carinho</p>
                        </div>
                    </div>

                    <div class="fundo-img-local ativo" id="kiki-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/Kiki Café.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="tartine-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">La Tartine</h3>
                            <p class="texto-dialogo-section3">Charmoso bistrô francês com clima intimista e receitas
                                autênticas. Cada prato parece
                                contar
                                uma história de Paris. Ideal para um jantar romântico.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="tartine-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/La Tertine.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="london-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">London Coffee Station</h3>
                            <p class="texto-dialogo-section3">Inspirado nas cafeterias londrinas, tem cafés fortes,
                                ambiente moderno e playlists
                                perfeitas.
                                Um ótimo ponto para trabalhar, conversar ou apenas apreciar um bom espresso.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local ativo" id="london-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/London coffee.png" alt="">
                    </div>
                </div>

                <div class="avaliacao-section3 displayFlex" id="vila-texto">
                    <div class="esquerda-section3 displayFlex">
                        <img src="~/assets/Icon/Mascoste/Husky-Section3.png" alt="" class="personagem">
                        <div class="caixa-dialogo">
                            <h3 class="titulo-caixa-dialogo">Vila Itororó</h3>
                            <p class="texto-dialogo-section3">Um espaço histórico que mistura arte, arquitetura e
                                cultura. Caminhar por ali é voltar no
                                tempo enquanto se inspira com intervenções criativas e eventos locais.</p>
                        </div>
                    </div>

                    <div class="fundo-img-local" id="vila-img">
                        <img class="img-local" src="~/assets/Img/CarrosselSecundario/vila.png" alt="">
                    </div>
                </div>
            </div>

            <div class="container-section3">
                <div class="carrossel-section3">
                    <div class="item-section3 bgc1-carrossel-section3" id="casaAntonia-crl"></div>
                    <div class="item-section3 bgc2-carrossel-section3" id="cafezal-crl"></div>
                    <div class="item-section3 bgc3-carrossel-section3" id="cinemateca-crl"></div>
                    <div class="item-section3 bgc4-carrossel-section3" id="hiTea-crl"></div>
                    <div class="item-section3 bgc5-carrossel-section3" id="jazz-crl"></div>
                    <div class="item-section3 bgc6-carrossel-section3" id="tartine-crl"></div>
                    <div class="item-section3 bgc7-carrossel-section3" id="london-crl"></div>
                    <div class="item-section3 bgc8-carrossel-section3" id="vila-crl"></div>
                    <div class="item-section3 bgc9-carrossel-section3" id="kiki-crl"></div>
                </div>
            </div>
        </section>
    </main>

    <!--? Footer -->

    <footer>
        <div class="conteudo-footer displayFlex">
            <img src="~/assets/Icon/Logos/Logo Branco.svg" alt="Logo do site Branco" class="logo-footer">
            <div class="saiba-mais">
                <h2 class="titulo-footer" style="white-space: nowrap;">Saiba mais</h2>
                <div class="lista-saiba-mais displayFlex">
                    <a href="" class="lista-saiba-mais">Termos de uso</a>
                    <a href="" class="lista-saiba-mais">Política de privacidade</a>
                    <a href="" class="lista-saiba-mais">Fale Conosco</a>
                </div>
            </div>
            <div class="redes-sociais displayFlex">
                <h2 class="titulo-footer" style="white-space: nowrap;">Redes Sociais</h2>
                <div class="top displayFlex">
                    <a href="">
                        <div class="fundo-icone displayFlex">
                            <img src="~/assets/Icon/RedesSociais/VectorInstagram.png" alt="Logo do Instagram"
                                class="icone">
                        </div>
                    </a>
                    <a href="">
                        <div class="fundo-icone displayFlex">
                            <img src="~/assets/Icon/RedesSociais/VectorYouTube.png" alt="Logo do YouTube" class="icone">
                        </div>
                    </a>
                    <a href="">
                        <div class="fundo-icone displayFlex">
                            <img src="~/assets/Icon/RedesSociais/VectorTwitter.png" alt="Logo do Twitter" class="icone">
                        </div>
                    </a>
                </div>
                <div class="botton displayFlex">
                    <div class="fundo-icone displayFlex">
                        <img src="~/assets/Icon/RedesSociais/VectorLinkedin.png" alt="Logo do Linkedin" class="icone">
                    </div>
                    <a href="">
                        <div class="fundo-icone displayFlex">
                            <img src="~/assets/Icon/RedesSociais/VectorTiktok.png" alt="Logo do Tiktok" class="icone">
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </footer>

     <dialog id="login-modal">
        <main class="container-login">
            <!-- Lado esquerdo -->
            <aside class="painel-esquerdo"></aside>

            <!-- Lado direito -->
            <section class="painel-direito">
                <button id="btn-fechar-login" class="fechar-modal">
                    <img src="assets/icon/Moldais/Close.svg" alt="Fechar" />
                </button>
                <img src="assets/Icon/Logos/Logo Branco.svg" alt="Logo do RolêSP" class="logo-modal" />
                <div class="cabecalho-modal">
                    <h2 class="titulo-modal">Login</h2>
                    <p class="subtitulo-modal">
                        Entre para começar a explorar o estado de São Paulo
                    </p>
                </div>

                <form class="form-modal" asp-action="Criar" asp-controller="Cadastro" method="post">
                    <label class="campo" for="email">E-mail:</label>
                    <input type="email" id="email" placeholder="email@email.com" required />

                    <label class="campo" for="senha">Senha:</label>
                    <input type="password" id="senha" placeholder="*********" required />

                    <button type="submit" class="botao-modal">ENTRAR</button>

                    <p class="erro-login">E-mail e senha incorretos</p>
                </form>

                <a href="#" class="link-esqueci texto-modal">Esqueceu sua senha?</a>
                <p class="texto-modal p2">
                    Não possui conta?
                    <a href="#" class="abrir-modal-cadastro trocar-modal">Crie uma!</a>
                </p>
            </section>
        </main>
    </dialog>

    <!-- Modal Cadastro -->
    <dialog id="cadastro-modal">
        <main class="container-login">
            <!-- Lado esquerdo -->
            <aside class="painel-esquerdo"></aside>

            <!-- Lado direito -->
            <section class="painel-direito">
                <button id="btn-fechar-cadastro" class="fechar-modal">
                    <img src="assets/icon/Moldais/Close.svg" alt="Fechar" />
                </button>
                <div class="cabecalho-modal">
                    <h2 class="titulo-modal">Cadastro</h2>
                    <p class="subtitulo-modal">
                        Crie sua conta para explorar o estado de São Paulo
                    </p>
                </div>
                <form id="formCadastro" class="form-modal" method="post">
                    <label class="campo" for="usuario">Usuário:</label>
                    <input type="text" id="usuario" name="nome" placeholder="Digite seu usuário" required />

                    <label class="campo" for="email-cadastro">E-mail:</label>
                    <input type="email" id="email-cadastro" name="email" placeholder="Digite seu email" required  />

                    <label class="campo" for="senha-cadastro">Senha:</label>
                    <input type="password" id="senha-cadastro" name = "senha" placeholder="Digite sua senha" required  />

                    <label class="campo" for="confirmar-senha">Confirmar senha:</label>
                    <input type="password" id="confirmar-senha" placeholder="" name = "confirmar" required />

                    <button type="submit" class="botao-modal">Cadastre-se</button>
                    <span id="erroCadastro"></span>
                </form>
    
            </section>
        </main>
    </dialog>

    <script src="~/js/landingPage.js" defer></script>
</body>

</html>