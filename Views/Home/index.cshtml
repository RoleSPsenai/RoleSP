@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/global.css">
    <link rel="stylesheet" href="~/css/feed.css">
    <link rel="stylesheet" href="~/css/post.css">
    <link rel="stylesheet" href="~/css/sair.css">
    <title>Feed</title>
</head>

<body>
    <header class="cabecalho">
        <div class="logo">
            <img class="logo-colorido" src="~/assets/Icon/Logos/Logo Colorido.svg" alt="Logo" />
        </div>
        <form action="buscar" method="get" class="pesquisar-locais">
            <div class="icone-container">
                <img class="icone-pesquisar" src="~/assets/Feed/Lupa.svg" alt="Ícone de lupa" />
            </div>
            <input type="text" id="pesquisa" placeholder="Pesquise..." name="pesquisa" />
        </form>

        <a class="botao-galeria" href="#">
            <img class="icone-galeria" src="~/assets/Feed/Galeria.svg" alt="Ícone da Galeria" />
            <span class="galeria">Galeria</span>
        </a>
    </header>

    <div class="conteudo">
        <aside class="parte-lateral">
            <section class="filtros-estabelecimentos">
                <nav class="menu">
                    <ul class="navegação">
                        <li>
                            <a class="lista-navegacao" href="#"><img class="icone-menu"
                                    src="~/assets/Feed/Café.svg" alt="Ícone-Cafeteria" />Cafeteria</a>
                        </li>
                        <li>
                            <a class="lista-navegacao" href="#"><img class="icone-menu"
                                    src="~/assets/Feed/Cultura.svg" alt="Ícone-Cultura" />Cultura</a>
                        </li>
                        <li>
                            <a class="lista-navegacao" href="#"><img class="icone-menu"
                                    src="~/assets/Feed/Livraria.svg" alt="Ícone-Livraria" />Livraria</a>
                        </li>
                        <li>
                            <a class="lista-navegacao" href="#"><img class="icone-menu"
                                    src="~/assets/Feed/Museu.svg" alt="Ícone-Museu" />Museu</a>
                        </li>
                        <li>
                            <a class="lista-navegacao" href="#"><img class="icone-menu"
                                    src="~/assets/Feed/Natureza.svg" alt="Ícone-Natureza" />Natureza</a>
                        </li>
                        <li>
                            <a class="lista-navegacao" href="#"><img class="icone-menu"
                                    src="~/assets/Feed/Restaurante.svg"
                                    alt="Ícone-Restaurante" />Restaurante</a>
                        </li>
                    </ul>
                </nav>
            </section>

            <section class="sair">
                <img class="foto-usuario" src="Assets/Img/perfil_galeria.png" alt="foto_usuario" />
                <div class="bloco-nome">
                    <h1 class="usuario">Carlinhos</h1>
                    <h2 class="nome-usuario">Carlos Eduardo</h2>
                </div>
                <button id="logout" class="lista-navegacao">
                    <img class="icone-sair-verde" src="Assets/Ícones/Ações/SairConta.svg" alt="Ícone-Sair" />
                </button>
            </section>
        </aside>

        <main>
            <h3 class="titulo-recomendacao">Recomendação Mensal</h3>
            <section class="recomendacao">
                <article class="card-recomendacao">
                    <img class="foto" src="Assets/Img/London coffee.svg" alt=> <img class="foto"
                        src="Assets/Img/London coffee.svg" alt=> <img class="foto" src="Assets/Img/London coffee.svg"
                        alt=> <img class="foto" src="Assets/Img/London coffee.svg" alt=> <img class="foto"
                        src="Assets/Img/London coffee.svg" alt=> <img class="foto" src="Assets/Img/London coffee.svg"
                        alt=> <img class="foto" src="Assets/Img/London coffee.svg" alt=>
